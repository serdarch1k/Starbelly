<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />
<link
  href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css"
  rel="stylesheet"
/>

<body>
  <!-- Background style -->
  <canvas class="liquid-canvas"></canvas>
  <div class="orbs"></div>
  <div class="cursor"></div>
  <div class="cursor-dot"></div>

  <!-- Login -->
  <div class="login">
    <form class="login__form" action="/admin/login" METHOD="POST">
      <h1 class="login__title">Login</h1>

      <div class="login__content">
        <div class="login__box">
          <i class="ri-user-3-line login__icon"></i>

          <div class="login__box-input">
            <input
              type="text"
              name="memberNick"
              class="login__input member-nick"
              placeholder=" "
              value=""
              required
            />
            <label for="login-username" class="login__label">Username</label>
          </div>
        </div>

        <div class="login__box">
          <i class="ri-lock-2-line login__icon"></i>

          <div class="login__box-input">
            <input
              type="password"
              name="memberPassword"
              class="login__input member-password"
              id="login-pass"
              placeholder=" "
              value=""
              required
            />
            <label for="login-pass" class="login__label">Password</label>
            <i class="ri-eye-off-line login__eye" id="login-eye"></i>
          </div>
        </div>
      </div>

      <div class="login__check">
        <div class="login__check-group">
          <input type="checkbox" class="login__check-input" id="login-check" />
          <label for="login-check" class="login__check-label"
            >Remember me</label
          >
        </div>

        <a href="#" class="login__forgot">Forgot Password?</a>
      </div>

      <button class="login__button" type="submit" name="login">Login</button>

      <p class="login__goback">Go back - <a href="/admin">Home</a></p>

      <p class="login__register">
        Don't have an account? - <a href="/admin/signup">Signup</a>
      </p>
    </form>
  </div>

  <script type="text/javascript" src="/js/login.js" defer></script>
</body>

<%- include('includes/footer') %>
