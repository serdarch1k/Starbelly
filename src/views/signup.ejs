<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />
<link
  href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css"
  rel="stylesheet"
/>

<body>
  <!-- Background style -->
  <canvas class="liquid-canvas"></canvas>
  <div class="orbs"></div>
  <div class="cursor"></div>
  <div class="cursor-dot"></div>

  <!-- Signup -->
  <div class="signup__container">
    <form
      onsubmit="return validateSignupForm();"
      class="signup__form"
      action="/admin/signup"
      method="POST"
      enctype="multipart/form-data"
    >
      <h1 class="signup__title">Signup</h1>

      <div class="signup__content">
        <div class="signup__box">
          <i class="ri-user-3-line signup__icon"></i>

          <div class="signup__box-input">
            <input
              type="text"
              name="memberNick"
              class="signup__input member-nick"
              placeholder=" "
              value=""
            />
            <label for="member-nick" class="signup__label">Username</label>
          </div>
        </div>

        <div class="signup__box">
          <i class="ri-phone-line signup__icon"></i>

          <div class="signup__box-input">
            <input
              type="text"
              name="memberPhone"
              class="signup__input member-phone"
              placeholder=" "
              value=""
            />
            <label for="member-phone" class="signup__label">Phone</label>
          </div>
        </div>
      </div>

      <div class="signup__content">
        <div class="signup__box">
          <i class="ri-rotate-lock-line signup__icon"></i>

          <div class="signup__box-input">
            <input
              type="password"
              name="memberPassword"
              class="signup__input member-password"
              id="signup-pass"
              placeholder=" "
              value=""
              required
            />
            <label for="signup-pass" class="signup__label">Password</label>
            <i class="ri-eye-off-line signup__eye" id="signup-eye"></i>
          </div>
        </div>

        <div class="signup__box">
          <i class="ri-rotate-lock-line signup__icon"></i>

          <div class="signup__box-input">
            <input
              type="password"
              name="confirmPassword"
              class="signup__input confirm-password"
              id="signup-repeat-pass"
              placeholder=" "
              value=""
              required
            />
            <label for="signup-repeat-pass" class="signup__label"
              >Repeat password</label
            >
            <i class="ri-eye-off-line signup__eye" id="signup-repeat-eye"></i>
          </div>
        </div>
      </div>

      <!-- Restaurant image -->
      <div class="signup-input-frame">
        <div class="media-frame">
          <img class="upload-img-frame" src="/img/default.jpeg" />
          <div class="upload-container">
            <span class="media-text">Restaurant image</span>
            <div
              class="file-box bs3-primary preview-image"
              style="margin-top: 25px; display: flex"
            >
              <input
                class="upload-name"
                value="Choose image"
                disabled="disabled"
              />
              <label for="input-file" class="file-input-label"
                >Upload Image</label
              >
              <input
                type="file"
                id="input-file"
                class="upload-hidden form-control-file member-image"
                name="memberImage"
              />
            </div>
            <p class="thumbnail-desc">
              Please upload restaurant image.<br />
              Attention only:.jpg, .jpeg, or .png. <br />
              formats allowed!
            </p>
          </div>
        </div>
      </div>

      <input name="memberType" value="RESTAURANT" hidden />

      <button class="signup__button" name="signup" type="submit">Signup</button>

      <div class="signup__footer">
        <p class="signup__goback">Go back - <a href="/admin">Home</a></p>

        <p class="signup__login">
          Already signed up? - <a href="/admin/login">Login</a>
        </p>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/signup.js" defer></script>
</body>

<%- include('includes/footer') %>
